# LLM credential for the quickstart. One key powers both Atryum's
# AI-evaluation judge and the demo agents.
#
# Required: an OpenAI or OpenAI-compatible API key.
MODEL_API_KEY=changeme

# Model used by the judge and the demo agents.
MODEL_NAME=gpt-4o

# Leave empty to use OpenAI. For any OpenAI-compatible endpoint (MaaS, vLLM,
# an OpenShift AI model server, …) set the base URL WITHOUT the /v1 suffix,
# e.g. https://my-maas-instance:443
MODEL_ENDPOINT=
